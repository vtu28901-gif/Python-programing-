def multiplication_table():
    # Get number from user
    num = int(input("Enter a number: "))

    # Generate multiplication table
    print(f"Multiplication table for {num}:")
    for i in range(1, 11):
        product = num * i
        print(f"{num} x {i} = {product}")

multiplication_table()
  
