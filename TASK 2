def otp_verification():
    # Define correct OTP and maximum attempts
    correct_otp = "4567"
    max_attempts = 3
    attempts = 0

    # Ask for OTP until correct or attempts are exhausted
    while attempts < max_attempts:
        otp = input("Enter OTP: ")
        if otp == correct_otp:
            print("OTP verification successful!")
            return
        else:
            attempts += 1
            print(f"Incorrect OTP. Attempts remaining: {max_attempts - attempts}")

    print("OTP verification failed. Attempts exhausted.")

otp_verification()

