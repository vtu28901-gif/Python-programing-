def water_level_monitoring():
    # Get water level from user
    water_level = float(input("Enter water level (in meters): "))

    # Check water level and issue warnings
    if water_level < 50:
        print("Low Water Level")
    elif 50 <= water_level <= 80:
        print("Normal Water Level")
    else:
        print("High Water Level - Caution!")

water_level_monitoring()

