def student_record_search():
    roll_numbers = [1, 2, 3, 4, 5]

    # Linear Search
    def linear_search(arr, target):
        for i in range(len(arr)):
            if arr[i] == target:
                return i
        return -1

    # Binary Search
    def binary_search(arr, target):
        low, high = 0, len(arr) - 1
        while low <= high:
            mid = (low + high) // 2
            if arr[mid] == target:
                return mid
            elif arr[mid] < target:
                low = mid + 1
            else:
                high = mid - 1
        return -1

    # Search for a roll number
    roll_number = int(input("Enter roll number: "))
    index = linear_search(roll_numbers, roll_number)
    if index != -1:
        print(f"Roll number {roll_number} found at index {index}")
    else:
        print(f"Roll number {roll_number} not found")

    # Binary search after sorting
    roll_numbers.sort()
    index = binary_search(roll_numbers, roll_number)
    if index != -1:
        print(f"Roll number {roll_number} found at index {index}")
    else:
        print(f"Roll number {roll_number} not found")

student_record_search()

