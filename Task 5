def product_price_sorting():
    prices = [100, 200, 50, 300, 400]

    # Bubble Sort
    def bubble_sort(arr):
        for i in range(len(arr)):
            for j in range(len(arr) - 1):
                if arr[j] > arr[j + 1]:
                    arr[j], arr[j + 1] = arr[j + 1], arr[j]
        return arr

    # Selection Sort
    def selection_sort(arr):
        for i in range(len(arr)):
            max_index = i
            for j in range(i + 1, len(arr)):
                if arr[j] > arr[max_index]:
                    max_index = j
            arr[i], arr[max_index] = arr[max_index], arr[i]
        return arr

    # Insertion Sort
    def insertion_sort(arr):
        for i in range(1, len(arr)):
            key = arr[i]
            j = i - 1
            while j >= 0 and arr[j] > key:
                arr[j + 1] = arr[j]
                j -= 1
            arr[j + 1] = key
        return arr

    print(f"Bubble sort: {bubble_sort(prices[:])}")
    print(f"Selection sort: {selection_sort(prices[:])}")
    print(f"Insertion sort: {insertion_sort(prices[:])}")

product_price_sorting()
