def shopping_cart():
    cart = {
        "Product1": 100,
        "Product2": 200,
        "Product3": 300,
        "Product4": 400,
        "Product5": 500
    }

    # Display all products with prices
    print("Products and prices:")
    for product, price in cart.items():
        print(f"{product}: {price}")

    # Find the total bill amount
    total_bill = sum(cart.values())
    print(f"Total bill: {total_bill}")

    # Update the price of one product
    cart["Product1"] = 150
    print(f"Updated price of Product1: {cart['Product1']}")

    # Remove a product from the cart
    del cart["Product2"]
    print("Product2 removed from cart")

shopping_cart()
                        
