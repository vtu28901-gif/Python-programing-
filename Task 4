def employee_records():
    employees = [
        (1, "Arun", 50000),
        (2, "Bala", 60000),
        (3, "Charlie", 40000),
        (4, "David", 70000),
        (5, "Eva", 55000)
    ]

    # Display the details of the highest paid employee
    highest_paid_employee = max(employees, key=lambda x: x[2])
    print(f"Highest paid employee: {highest_paid_employee}")

    # Extract only the employee names into a list
    employee_names = [employee[1] for employee in employees]
    print(f"Employee names: {employee_names}")

    # Count how many employees earn more than 50,000
    high_earners = len([employee for employee in employees if employee[2] > 50000])
    print(f"Employees earning more than 50,000: {high_earners}")

employee_records()

