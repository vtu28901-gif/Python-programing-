    with open("students.txt", "w") as file:
        file.write("John 90\n")
        file.write("Alice 85\n")

    # Read and display all student records
    with open("students.txt", "r") as file:
        print(file.read())

    # Append new student data to the same file
    with open("students.txt", "a") as file:
        file.write("Bob 95\n")

    # Search for a student by name in the file
    with open("students.txt", "r") as file:
        for line in file:
            if "John" in line:
                print(line.strip())

