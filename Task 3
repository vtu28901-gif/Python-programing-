def employee_performance():
    # Store data for 5 employees
    employees = [
        ("Arun", 85),
        ("Bala", 90),
        ("Charlie", 78),
        ("David", 92),
        ("Eva", 88)
    ]

    # Display the employee with the highest score
    highest_scorer = max(employees, key=lambda x: x[1])
    print(f"Employee with the highest score: {highest_scorer[0]} with score {highest_scorer[1]}")

    # Display all employees who scored more than 80
    high_performers = [employee for employee in employees if employee[1] > 80]
    print("Employees who scored more than 80:")
    for employee in high_performers:
        print(f"{employee[0]} - {employee[1]}")

employee_performance()

