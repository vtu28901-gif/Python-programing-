def movie_ticket_booking():
    # Define ticket prices for different categories
    ticket_prices = [200, 150, 300]  # Gold, Silver, Platinum

    # Calculate total cost of tickets purchased by a customer
    num_tickets = int(input("Enter number of tickets: "))
    total_cost = 0
    for i in range(num_tickets):
        category = input("Enter category (Gold/Silver/Platinum): ")
        if category.lower() == "gold":
            total_cost += ticket_prices[0]
        elif category.lower() == "silver":
            total_cost += ticket_prices[1]
        elif category.lower() == "platinum":
            total_cost += ticket_prices[2]
        else:
            print("Invalid category. Skipping...")

    print(f"Total cost: {total_cost}")

    # Find the highest-priced ticket
    highest_priced_ticket = max(ticket_prices)
    print(f"Highest priced ticket: {highest_priced_ticket}")

    # Find the lowest-priced ticket
    lowest_priced_ticket = min(ticket_prices)
    print(f"Lowest priced ticket: {lowest_priced_ticket}")

movie_ticket_booking()

