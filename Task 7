def deposit(balance, amount):
    return balance + amount

def withdraw(balance, amount):
    if balance >= amount:
        return balance - amount
    else:
        return "Insufficient balance"

def display_balance(balance):
    print(f"Available balance: {balance}")

balance = 1000
