contact_number_entry.grid(row=3, column=1, padx=10, pady=10)

submit_button = tk.Button(root, text="Submit", command=submit_fields)
submit_button.grid(row=4, column=0, padx=10, pady=10)

reset_button = tk.Button(root, text="Reset", command=reset_fields)
