tk.Label(root, text="Employee ID", bg="#f0f0f0").grid(row=0, column=0, padx=10, pady=10)
employee_id_entry = tk.Entry(root)
employee_id_entry.grid(row=0, column=1, padx=10, pady=10)

tk.Label(root, text="Name", bg="                                                 
name_entry = tk.Entry(root)
name_entry.grid(row=1, column=1, padx=10, pady=10)

tk.Label(root, text="#f0f0f0").grid(row=1, column=0, padx=10, pady=10)
name_entry = tk.Entry(root)
name_entry.grid(row=1, column=1, padx=10, pady=10)

tk.Label(root, text="Department", bg="#f0f0f0").grid(row=2, column=0, padx=10, pady=10)
department_entry = tk.Entry(root)
department_entry.grid(row=2, column=1, padx=10, pady=10)

tk.Label(root, text="Contact Number", bg="                                                 
contact_number_entry = tk.Entry(root)
contact_number_entry.grid(row=3, column=1, padx=10, pady=10)

submit_button = tk.Button(root, text="#f0f0f0").grid(row=3, column=0, padx=10, pady=10)
