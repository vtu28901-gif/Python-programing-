import tkinter as tk
from tkinter import messagebox

def submit_fields():
    employee_id = employee_id_entry.get()
    name = name_entry.get()
    department = department_entry.get()
    contact_number = contact_number_entry.get()
    details = f"Employee ID: {employee_id}\nName: {name}\nDepartment: {department}\nContact Number: {contact_number}"
    messagebox.showinfo("Employee Details", details)

def reset_fields():
    employee_id_entry.delete(0, tk.END)
    name_entry.delete(0, tk.END)
    department_entry.delete(0, tk.END)
    contact_number_entry.delete(0, tk.END)

root = tk.Tk()
root.title("Employee Registration Form")
root.geometry("400x300")
root.configure(bg="         

