def compare_scores():
    # Get scores from user
    score1 = float(input("Enter first student's score: "))
    score2 = float(input("Enter second student's score: "))

    # Evaluate relational expressions
    is_greater = score1 > score2
    is_lesser = score1 < score2
    is_equal = score1 == score2

    # Display results
    print(f"Is score1 greater than score2? {is_greater}")
    print(f"Is score1 lesser than score2? {is_lesser}")
    print(f"Are score1 and score2 equal? {is_equal}")

compare_scores()

