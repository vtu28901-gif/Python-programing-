def calculate_bill():
    # Get price values from user
    price1 = float(input("Enter first price: "))
    price2 = float(input("Enter second price: "))

    # Perform mathematical operations
    addition = price1 + price2
    subtraction = price1 - price2
    multiplication = price1 * price2
    division = price1 / price2 if price2 != 0 else "Error: Division by zero"

    # Display results
    print(f"Addition: {addition}")
    print(f"Subtraction: {subtraction}")
    print(f"Multiplication: {multiplication}")
    print(f"Division: {division}")

calculate_bill()

