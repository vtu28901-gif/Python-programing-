def check_candidate_qualification():
    # Get test scores from user
    test1 = float(input("Enter score for test 1: "))
    test2 = float(input("Enter score for test 2: "))
    test3 = float(input("Enter score for test 3: "))

    # Define qualification criteria
    min_score = 50
    min_average = 60

    # Evaluate logical conditions
    is_qualified = (test1 >= min_score and test2 >= min_score and test3 >= min_score) and ((test1 + test2 + test3) / 3 >= min_average)

    # Display result
    print(f"Is the candidate qualified? {is_qualified}")

check_candidate_qualification()
